# Copy this file to .env and fill in real values for local development.
# NEVER commit .env. NEVER put secrets in apps/web (only VITE_-prefixed
# vars in apps/web/.env are exposed to the browser bundle).

NODE_ENV=development
PORT=4000

APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-char-secret-before-running-in-production
JWT_EXPIRES_IN=7d

# --- AI provider abstraction (see packages/ai) ---
# Phase 1 only implements "mock" (deterministic, offline, no network calls).
# "openai" and "local" are defined for a future phase and will throw
# AIProviderNotImplementedError until then.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Storage (Phase 2: resume/CV uploads) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=

# --- Job sources (Phase 7) ---
GREENHOUSE_ENABLED=false
LEVER_ENABLED=false
ASHBY_ENABLED=false

# --- Encryption (Phase 2+: encrypting sensitive candidate data at rest) ---
ENCRYPTION_KEY=replace-with-a-random-32-char-key-before-running-in-production
