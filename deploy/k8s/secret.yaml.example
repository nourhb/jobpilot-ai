# Copy to secret.yaml locally. Never commit real values.
# kubectl create secret generic jobpilot-secrets -n jobpilot \
#   --from-literal=DATABASE_URL=postgresql://jobpilot:jobpilot@postgres:5432/jobpilot \
#   --from-literal=REDIS_URL=redis://redis:6379 \
#   --from-literal=JWT_SECRET=replace-me \
#   --from-literal=ENCRYPTION_KEY=replace-me \
#   --from-literal=POSTGRES_PASSWORD=jobpilot
apiVersion: v1
kind: Secret
metadata:
  name: jobpilot-secrets
  namespace: jobpilot
type: Opaque
stringData:
  DATABASE_URL: postgresql://jobpilot:change-me@postgres:5432/jobpilot
  REDIS_URL: redis://redis:6379
  JWT_SECRET: change-me-to-at-least-32-characters-long
  ENCRYPTION_KEY: change-me-to-a-random-key
  POSTGRES_PASSWORD: change-me
