// JobPilot AI - Prisma schema
//
// Grows incrementally, one phase at a time (see docs/architecture.md,
// "Development Phases"), rather than being generated up front against an
// empty feature set.
//
// PHASE 1: User, AuditLog (authentication).
// PHASE 2: Profile, Resume, WorkExperience, Education, Skill,
//          Certification (candidate truth layer -- see
//          apps/api/src/profile/truthLayer.ts).
// PHASE 3: JobSource, Job (discovery, normalization, deduplication --
//          see apps/api/src/jobs/).
// PHASE 4: JobPreference, JobMatch (hybrid scoring + AI semantic
//          interpretation -- see apps/api/src/matching/).
// PHASE 6: Application, CoverLetter, ApplicationAnswer, ApplicationEvent
//          (the Application Engine, Mock ATS, Validator, and Policy
//          Engine -- see apps/api/src/applications/).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  city         String?
  province     String?
  country      String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs      AuditLog[]
  profile        Profile?
  jobPreference  JobPreference?
  jobMatches     JobMatch[]
  applications   Application[]

  @@map("users")
}

/// Grows as new phases introduce new audited events (JOB_DISCOVERED,
/// APPLICATION_SUBMITTED, AGENT_STARTED, ...).
enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  PROFILE_UPDATED
  CV_UPLOADED
  CV_PARSED
  PROFILE_ITEM_VERIFIED
  JOB_DISCOVERY_RUN
  PREFERENCES_UPDATED
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String?
  entityId   String?
  /// Never store secrets, passwords, full CV text or full application
  /// answers here (see docs/security.md).
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// PHASE 2: Profile, Resume, and the "truth layer" entities.
//
// Section 24 of the spec: only rows with `verified = true` may ever be
// read by apps/api/src/profile/truthLayer.ts and fed into AI prompts.
// Resume-parser output is inserted as `verified = false`; it becomes
// eligible only after the user explicitly confirms it via
// POST /api/profile/verify (see docs/architecture.md, "Truth Layer").
// Manually-entered/edited items are marked `verified = true` immediately
// because the user typed them directly.
// ---------------------------------------------------------------------

/// UI-facing options are NOT hard-coded across the frontend (section 7 /
/// spec section "Profile") -- the canonical list lives once in
/// packages/shared/src/constants/index.ts (WORK_AUTHORIZATION_STATUSES)
/// and both the Zod schema and this enum are generated from that single
/// source of intent. Prisma enums are still statically declared at the
/// database level, which is an accepted trade-off.
enum WorkAuthorizationStatus {
  CANADIAN_CITIZEN
  PERMANENT_RESIDENT
  OPEN_WORK_PERMIT
  CLOSED_WORK_PERMIT
  STUDENT_PERMIT
  REQUIRES_SPONSORSHIP
  OTHER
}

enum RemotePreference {
  REMOTE
  HYBRID
  ONSITE
  ANY
}

enum ProfileItemSource {
  MANUAL
  RESUME_PARSER
}

model Profile {
  id                   String                   @id @default(uuid())
  userId               String                   @unique
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalSummary  String?
  yearsOfExperience    Float?
  workAuthorization    WorkAuthorizationStatus?
  requiresSponsorship  Boolean                  @default(false)
  willingToRelocate    Boolean                  @default(false)
  remotePreference     RemotePreference?
  minimumSalary        Int?
  maximumSalary        Int?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  resumes         Resume[]
  workExperiences WorkExperience[]
  educations      Education[]
  skills          Skill[]
  certifications  Certification[]

  @@map("profiles")
}

/// The original uploaded document is never overwritten (section 8) --
/// every upload creates a new row/version; `isActive` marks the one
/// currently used to seed truth-layer suggestions.
model Resume {
  id               String   @id @default(uuid())
  profileId        String
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  originalFileName String
  storageKey       String
  mimeType         String
  fileSize         Int
  parsedText       String?
  parsedJson       Json?
  /// 0..1 completeness/confidence score computed by
  /// apps/api/src/profile/resumeConfidence.ts. Below the review
  /// threshold, `reviewRequired` is set and extracted rows stay
  /// unverified until the user confirms them.
  confidenceScore  Float?
  reviewRequired   Boolean  @default(true)
  version          Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([profileId])
  @@map("resumes")
}

model WorkExperience {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  jobTitle    String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  source      ProfileItemSource @default(MANUAL)
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([profileId])
  @@map("work_experiences")
}

model Education {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  source      ProfileItemSource @default(MANUAL)
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([profileId])
  @@map("educations")
}

model Skill {
  id              String            @id @default(uuid())
  profileId       String
  profile         Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  proficiency     String?
  yearsExperience Float?
  source          ProfileItemSource @default(MANUAL)
  verified        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([profileId, name])
  @@index([profileId])
  @@map("skills")
}

model Certification {
  id         String            @id @default(uuid())
  profileId  String
  profile    Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  issuer     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  source     ProfileItemSource @default(MANUAL)
  verified   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([profileId])
  @@map("certifications")
}

// ---------------------------------------------------------------------
// PHASE 3: Job source architecture, normalization, deduplication.
//
// Every source (Greenhouse, Lever, Ashby, Workable, a bespoke company
// API, or the in-repo Mock adapter used for dev/tests) implements the
// same `JobSourceAdapter` contract (packages/source-adapters). The
// discovery pipeline (apps/api/src/jobs/jobDiscovery.service.ts) fetches
// RawJob[] from each enabled JobSource, normalizes it to a common shape,
// computes a contentHash, de-duplicates, then upserts here. See spec
// sections 13-21 and docs/architecture.md.
// ---------------------------------------------------------------------

enum JobSourceType {
  GREENHOUSE
  LEVER
  ASHBY
  WORKABLE
  COMPANY
  MOCK
}

/// One row per configured job source (e.g. "Greenhouse: Acme Corp").
/// Real per-source credentials/board tokens belong in `config`, but
/// never secrets -- those stay in environment variables (section 51).
model JobSource {
  id        String        @id @default(uuid())
  name      String        @unique
  type      JobSourceType
  config    Json          @default("{}")
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  jobs Job[]

  @@map("job_sources")
}

enum RemoteType {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  UNKNOWN
}

enum JobApplicationType {
  API
  PUBLIC_FORM
  MANUAL
  UNKNOWN
}

/// ACTIVE jobs are eligible for matching/application. EXPIRED/REMOVED
/// are kept (never deleted -- section 65, application evidence must
/// remain reproducible) but excluded from discovery-facing queries.
enum JobStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

model Job {
  id       String    @id @default(uuid())
  sourceId String
  source   JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// The source's own identifier for this posting (e.g. a Greenhouse
  /// gh_jid). Combined with sourceId, this is the primary duplicate key
  /// (section 21).
  externalId String

  title           String
  company         String
  description     String
  descriptionHtml String?

  /// Original, unparsed location string from the source, kept for
  /// display when structured city/province/country extraction fails.
  locationRaw String?
  city        String?
  province    String?
  country     String?

  remoteType      RemoteType        @default(UNKNOWN)
  employmentType  JobEmploymentType @default(UNKNOWN)
  experienceLevel String?

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  salaryPeriod   String?

  jobUrl          String?
  applicationType JobApplicationType @default(UNKNOWN)
  applicationUrl  String?

  postedAt   DateTime?
  expiresAt  DateTime?
  lastSeenAt DateTime  @default(now())

  /// Unmodified payload from the source adapter (RawJob.raw), kept for
  /// audit/debugging and so normalization can be re-run if the mapping
  /// logic changes without re-fetching from the source.
  rawData Json
  /// SHA-256 over normalized title+company+description -- tertiary
  /// duplicate detection (see packages/source-adapters/src/dedup.ts).
  contentHash String
  /// normalized company::title::location -- secondary duplicate
  /// detection, indexed for a direct lookup instead of recomputing over
  /// every stored job on each discovery run.
  secondaryDedupeKey String

  status    JobStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  matches      JobMatch[]
  applications Application[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([externalId])
  @@index([contentHash])
  @@index([secondaryDedupeKey])
  @@map("jobs")
}

// ---------------------------------------------------------------------
// PHASE 4: Job preferences + AI-assisted matching.
//
// Section 26 of the spec: "Don't rely exclusively on the LLM. Use a
// hybrid score." The numeric score and every weighted component below
// are always computed deterministically by
// apps/api/src/matching/scoring.ts; the AI provider is only ever asked
// for narrative interpretation (reasons/missingRequirements/riskFlags)
// layered on top of a score it did not produce -- consistent with "the
// LLM is not the source of truth" (see AGENTS/architecture notes).
// ---------------------------------------------------------------------

/// One row per user (section 12). Drives both the hard filters
/// (apps/api/src/matching/hardFilters.ts) and the "preferences" 5% slice
/// of the hybrid score.
model JobPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetTitles   String[] @default([])
  excludedTitles String[] @default([])

  countries String[] @default(["Canada"])
  provinces String[] @default([])
  cities    String[] @default([])

  remote Boolean @default(true)
  hybrid Boolean @default(true)
  onsite Boolean @default(true)

  minSalary Int?
  maxSalary Int?

  employmentTypes JobEmploymentType[] @default([])
  /// Free-text (e.g. "entry", "mid", "senior", "lead") -- Job.experienceLevel
  /// is itself unstructured (section 13), so there is no fixed enum to
  /// validate against yet.
  experienceLevels String[] @default([])

  maxDistanceKm Int?

  /// Section 27 hard filter: skip jobs when the candidate's own
  /// Profile.workAuthorization has not been declared -- there is no
  /// reliable way to answer a "legally authorized to work?" application
  /// question (section 32) without it.
  requireWorkAuthorization Boolean @default(true)
  /// Section 27 hard filter: when the candidate's Profile.requiresSponsorship
  /// is true, skip jobs whose description text signals the employer will
  /// not sponsor (apps/api/src/matching/sponsorshipSignal.ts -- a
  /// keyword heuristic over the posting text, since no source adapter
  /// exposes a structured "sponsorship offered" field). Never skips
  /// anything when the candidate does not require sponsorship.
  requireNoSponsorship Boolean @default(true)

  /// Section 28: the user's own auto-apply threshold. Match categories
  /// (EXCELLENT/STRONG/POTENTIAL/LOW) are fixed system buckets computed
  /// from the score alone; this is the separate, user-chosen cutoff that
  /// turns a category into an actual APPLY decision (see JobMatch.decision).
  minimumMatchScore Int @default(70)

  autoApplyEnabled          Boolean @default(false)
  autoCoverLetterEnabled    Boolean @default(false)
  autoQuestionAnswerEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("job_preferences")
}

/// Section 28 system thresholds -- fixed, not user-configurable ("These
/// are system thresholds, not a judgment about the job itself").
enum MatchCategory {
  EXCELLENT
  STRONG
  POTENTIAL
  LOW
}

/// The system's own authoritative decision, derived deterministically
/// from `score` vs. the user's JobPreference.minimumMatchScore (or from
/// a hard filter having skipped the job outright). Distinct from
/// `aiSuggestedDecision`, which is the AI provider's own advisory
/// opinion and is never used to drive auto-apply.
enum MatchDecision {
  APPLY
  REVIEW
  SKIP
}

model JobMatch {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Final weighted score, 0-100 (section 26: 30% skills + 20% experience
  /// + 15% title similarity + 10% location + 10% authorization + 5%
  /// salary + 5% employment type + 5% preferences).
  score         Int
  matchCategory MatchCategory
  decision      MatchDecision

  skillsScore         Int
  experienceScore     Int
  titleScore          Int
  locationScore       Int
  authorizationScore  Int
  salaryScore         Int
  employmentTypeScore Int
  preferencesScore    Int

  /// Populated only when a hard filter (section 27) skipped this job
  /// before scoring; score/component fields are all 0 in that case.
  skippedReason String?

  /// AI semantic interpretation layered on top of the deterministic
  /// score (section 25) -- never the source of the numeric scores above.
  aiSuggestedDecision String?
  reasons             String[] @default([])
  missingRequirements String[] @default([])
  riskFlags           String[] @default([])
  aiModel             String?
  aiPromptVersion     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("job_matches")
}

// ---------------------------------------------------------------------
// PHASE 6: The Application Engine, Mock ATS, Validator, and Policy
// Engine.
//
// Section 34's state machine plus its failure states, combined into one
// enum exactly as the master prompt's own "APPLICATION STATES" list
// enumerates them. An Application row is only ever created once a
// JobMatch with decision APPLY or REVIEW already exists for the
// (userId, jobId) pair -- DISCOVERED/NORMALIZED/MATCHED are considered
// satisfied by the Job/JobMatch rows that already exist by that point,
// so apps/api/src/applications/application.service.ts starts a new
// Application directly at QUALIFIED.
// ---------------------------------------------------------------------

enum ApplicationStatus {
  DISCOVERED
  NORMALIZED
  MATCHED
  QUALIFIED
  PREPARING
  VALIDATING
  READY
  SUBMITTING
  SUBMITTED
  MANUAL_REVIEW
  BLOCKED
  FAILED
  SKIPPED
  DUPLICATE
  EXPIRED
}

/// Kept in sync by hand with packages/shared's QUESTION_CATEGORIES
/// (section 31).
enum QuestionCategory {
  PROFILE_FACT
  EXPERIENCE_FACT
  EDUCATION_FACT
  YES_NO_FACT
  PREFERENCE
  MOTIVATIONAL
  UNKNOWN
  LEGAL
  HIGH_RISK
}

/// Section 42 (Idempotency) + master prompt ("Keep immutable snapshots
/// of the job, candidate information, cover letter and answers used for
/// each application"). `jobSnapshot`/`candidateSnapshot` are captured
/// once at creation time and never updated afterward, even if the
/// underlying Job or Profile rows change later -- an Application must
/// always be explainable from exactly what was true when it ran.
model Application {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status ApplicationStatus @default(QUALIFIED)

  /// sha256(userId + job.source.type + job.externalId) -- section 42:
  /// "If worker crashes after submission but before saving the result,
  /// restarting must not submit again."
  idempotencyKey String @unique

  jobSnapshot       Json
  candidateSnapshot Json

  matchScore    Int
  matchCategory MatchCategory

  /// Populated whenever the Policy Engine (section 78) or Validator
  /// (section 36) routes the application to manual review instead of
  /// submitting (CAPTCHA, unsupported source, unanswerable question,
  /// failed fact check, ...). Surfaced verbatim in the Manual Review UI
  /// (section 46).
  manualReviewReason String?
  /// Populated when the Policy Engine outright refuses the application
  /// (e.g. a hard safety-rule violation) rather than merely deferring
  /// it to a human.
  blockedReason String?
  /// Populated on an adapter-level submission failure (section 38:
  /// distinct from BLOCKED/MANUAL_REVIEW, which are policy decisions).
  failureReason String?

  submittedAt            DateTime?
  externalApplicationId  String?

  coverLetter CoverLetter?
  answers     ApplicationAnswer[]
  events      ApplicationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Section 42: "Application table: unique(userId, jobId)" -- the
  /// database-level backstop behind the Policy Engine's own duplicate
  /// check (RULE-006).
  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
  @@map("applications")
}

/// Section 29/30. One row per Application (an application is never
/// re-generated in place -- retrying creates a new cover letter and
/// this row is simply overwritten, since only the latest attempt's
/// content is ever actually submittable).
model CoverLetter {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  content      String
  model        String
  promptVersion String

  createdAt DateTime @default(now())

  @@map("cover_letters")
}

/// Section 31-33/37. One row per application-form question encountered,
/// including BLOCKED ones -- the Manual Review UI (section 46) needs to
/// show exactly which question(s) could not be answered and why.
model ApplicationAnswer {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  questionText String
  category     QuestionCategory

  status String // "ANSWERED" | "BLOCKED" -- mirrors QuestionAnswerResult (@jobpilot/shared)
  answer String?
  /// "FACT" | "AI_GROUNDED" | null (null only when status is BLOCKED)
  source String?
  blockedReason String?

  /// Section 37: the Fact Checker's own verdict on AI_GROUNDED answers
  /// (null for FACT answers, which never go through the AI at all).
  factCheckValid       Boolean?
  factCheckConfidence  Float?
  factCheckUnsupported String[] @default([])

  aiModel         String?
  aiPromptVersion String?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("application_answers")
}

/// Section 45's "TIMELINE" -- an append-only audit trail of every state
/// transition a single Application went through, distinct from the
/// account-level AuditLog (which never stores per-application detail).
model ApplicationEvent {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status  ApplicationStatus
  message String?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("application_events")
}
